class Solution {
    public int[][] construct2DArray(int[] original, int m, int n) {
        // If the total capacity does not match the 1D array length, return an empty 2D array
        if (original.length != m * n) {
            return new int[0][0];
        }
        
        int[][] result = new int[m][n];
        
        // Populate the 2D array row by row
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                // Formula to map 2D coordinates back to the 1D index
                result[i][j] = original[i * n + j];
            }
        }
        
        return result;
    }
}
