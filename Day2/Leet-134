class Solution {
    public int canCompleteCircuit(int[] gas, int[] cost) {
       int start=0;
       int gain=0;
       int total=0;
       int n=gas.length;

      for(int i=0;i<n;i++)
      {
        total+=gas[i]-cost[i];
      }
      for(int i=0;i<n;i++)
      {
        gain+=gas[i]-cost[i];

        if(gain<0)
        {
            gain=0;
            start=i+1;
        }
      }

      if(total>=0)
      {
        return start;
      }
      return -1;
    }
}
