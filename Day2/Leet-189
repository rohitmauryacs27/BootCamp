class Solution {
    public int[] rotate(int[] nums, int k) {
        
         int n=nums.length;
        k=k%n;
        int arr[]=new int[n];

        for(int i=0;i<n;i++)
        {
            arr[(i+k)%n]=nums[i];
        }
        for(int j=0;j<n;j++)
    {
        nums[j]=arr[j];
    }
     return nums;
    }
    }
